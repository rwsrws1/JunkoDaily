<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 第一层（底层）：色号为 #545D7E 的纯色圆形背景 -->
    <item android:start="50dp"
        android:end="50dp"
        android:top="50dp"
        android:bottom="50dp">
        <shape android:shape="oval">
            <solid android:color="#545D7E" />
        </shape>
    </item>

    <!-- 第二层（顶层）：叠加的图片资源 -->
    <item  android:start="50dp"
        android:end="50dp"
        android:top="50dp"
        android:bottom="50dp"
        android:drawable="@drawable/brush" />

</layer-list>